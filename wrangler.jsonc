{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "umpi-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "UMPI_TIMEZONE": "UTC",
    "UMPI_MODEL_PROVIDER": "anthropic",
    "UMPI_MODEL_ID": "claude-opus-5-5"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ASSISTANT", "class_name": "Assistant" },
      { "name": "CODING_WORKER", "class_name": "CodingWorker" },
      { "name": "BROWSER_WORKER", "class_name": "BrowserWorker" },
      { "name": "TAILNET_BRIDGE", "class_name": "TailnetBridge" },
      { "name": "CLOUD_MACHINE", "class_name": "CloudMachine" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Assistant"] },
    { "tag": "v2-vault-sync", "new_sqlite_classes": ["VaultSync"] },
    { "tag": "v3-coding-worker", "new_sqlite_classes": ["CodingWorker"] },
    { "tag": "v4-browser-worker", "new_sqlite_classes": ["BrowserWorker"] },
    { "tag": "v5-retire-vault-sync", "deleted_classes": ["VaultSync"] },
    { "tag": "v6-tailnet-bridge", "new_sqlite_classes": ["TailnetBridge"] },
    { "tag": "v7-cloud-machine", "new_sqlite_classes": ["CloudMachine"] }
  ],
  "containers": [{
    "class_name": "CodingWorker",
    "image": "./containers/coding/Dockerfile",
    "image_build_context": ".",
    "instance_type": "basic",
    "max_instances": 1
  }, {
    "class_name": "TailnetBridge",
    "image": "./containers/tailnet/Dockerfile",
    "image_build_context": ".",
    "instance_type": "lite",
    "max_instances": 1
  }, {
    "class_name": "CloudMachine",
    "image": "./containers/cloud-machine/Dockerfile",
    "image_build_context": ".",
    "instance_type": "standard-2",
    "max_instances": 6
  }],
  "r2_buckets": [
    { "binding": "CODING_ARCHIVE", "bucket_name": "replace-with-umpi-coding-state" },
    { "binding": "BROWSER_ARCHIVE", "bucket_name": "replace-with-umpi-browser-state" },
    { "binding": "OBSY_LIBRARY", "bucket_name": "replace-with-obsy-vault" }
  ],
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" }
}
