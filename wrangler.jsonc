{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "umpi-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "UMPI_TIMEZONE": "UTC",
    "UMPI_MODEL_PROVIDER": "anthropic",
    "UMPI_MODEL_ID": "claude-opus-5-5"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ASSISTANT", "class_name": "Assistant" },
      { "name": "VAULT_SYNC", "class_name": "VaultSync" },
      { "name": "CODING_WORKER", "class_name": "CodingWorker" },
      { "name": "BROWSER_WORKER", "class_name": "BrowserWorker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Assistant"] },
    { "tag": "v2-vault-sync", "new_sqlite_classes": ["VaultSync"] },
    { "tag": "v3-coding-worker", "new_sqlite_classes": ["CodingWorker"] },
    { "tag": "v4-browser-worker", "new_sqlite_classes": ["BrowserWorker"] }
  ],
  "containers": [{
    "class_name": "VaultSync",
    "image": "./containers/vault-sync/Dockerfile",
    "image_build_context": ".",
    "instance_type": "lite",
    "max_instances": 1
  }, {
    "class_name": "CodingWorker",
    "image": "./containers/coding/Dockerfile",
    "image_build_context": ".",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "r2_buckets": [
    { "binding": "VAULT_ARCHIVE", "bucket_name": "replace-with-umpi-vault-state" },
    { "binding": "CODING_ARCHIVE", "bucket_name": "replace-with-umpi-coding-state" },
    { "binding": "BROWSER_ARCHIVE", "bucket_name": "replace-with-umpi-browser-state" }
  ],
  "browser": { "binding": "BROWSER" }
}
