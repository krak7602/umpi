{
  "name": "umpi",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli/dev.ts",
    "mac": "tsx src/mac/cli.ts",
    "auth": "node --env-file-if-exists=.dev.vars --import tsx src/model/cli.ts",
    "memory": "node --env-file-if-exists=.dev.vars --import tsx src/cli/core-context.ts",
    "calendar": "tsx src/cli/calendar.ts",
    "mail": "tsx src/cli/mail.ts",
    "vault": "node --env-file-if-exists=.dev.vars --import tsx src/cli/vault.ts",
    "coding": "node --env-file-if-exists=.dev.vars --import tsx src/cli/coding.ts",
    "browser": "tsx src/cli/browser.ts",
    "setup": "tsx src/cli/setup.ts",
    "telegram": "node --env-file-if-exists=.dev.vars --import tsx src/cli/telegram.ts",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.mac.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "node --env-file-if-exists=.dev.vars --import tsx src/cli/deploy.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/playwright": "1.3.6",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@js-temporal/polyfill": "0.5.1",
    "@obsy/agent": "file:vendor/obsy/obsy-agent-0.0.0.tgz",
    "@obsy/core": "file:vendor/obsy/obsy-core-0.0.0.tgz",
    "@obsy/merge": "file:vendor/obsy/obsy-merge-0.0.0.tgz",
    "@obsy/protocol": "file:vendor/obsy/obsy-protocol-0.0.0.tgz",
    "@obsy/storage-r2": "file:vendor/obsy/obsy-storage-r2-0.0.0.tgz",
    "agents": "0.28.1",
    "html-to-text": "10.0.1",
    "marked": "18.1.1",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "obsidian-headless": "0.0.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
